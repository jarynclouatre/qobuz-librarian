# Copy this file to .env and edit it.
#   cp .env.example .env
# Most installs only set what is in this first block.

# Your music folder. Create it before the first start (Docker creates a
# missing one as root, which the app can't write to). It should hold only music.
QL_MUSIC_DIR=./music

# The app runs as this user and group. Use your `id -u` and `id -g` if they
# are not 1000.
# PUID=1000
# PGID=1000

# Host port the web UI is published on.
WEB_PORT=8666

# ── Other host directories mounted into the container ─────────────────────────
# Music, staging, and upgrade-backup directories must be separate. Do not put
# any one of them inside another.

# Scratch space for in-progress streamrip downloads. Keep it on a local disk:
# downloads refuse a staging folder on an NFS, SMB/CIFS or rclone mount.
QL_STAGING_DIR=./staging

# Backups of files Upgrade, Repair and the other tools replace.
QL_UPGRADE_BACKUPS=./upgrade_backups

# Where collection backups are kept for rebuilding a lost library.
QL_COLLECTION_BACKUPS=./collection_backups

# Library migration (optional; only for the one-time migration tool). These are
# container paths; mount the matching host folders in Compose before using them.
# See docs/existing-libraries.md for the full example.
# MIGRATE_SRC=/migrate-source
# MIGRATE_DEST=/migrate-dest

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host interface the port is published on. Default 0.0.0.0 = reachable from your
# LAN. Set 127.0.0.1 to keep the UI reachable only from the Docker host.
# WEB_HOST is the in-container bind and must stay 0.0.0.0.
# WEB_BIND=0.0.0.0

# Login. Unset, the web UI asks for a username and password on first visit,
# then requires sign-in. WEB_AUTH=none turns the login off: use it only on a
# trusted network or behind your own authenticating reverse proxy.
# WEB_AUTH=none

# Set the login here instead of on the first-visit setup screen. Both are
# needed, and they double as a password reset: change them and restart. The
# password needs at least 15 characters; common and product-name passwords are
# refused. Compose reads a $ as the start of a variable, so put a password
# that contains one in single quotes. You can clear these after first start;
# the login persists.
# WEB_AUTH_USER=admin
# WEB_AUTH_PASSWORD=change-me-to-something-strong
# Or read the password from a file (e.g. a Docker secret):
# WEB_AUTH_PASSWORD_FILE=/run/secrets/qobuz_web_password

# Behind a reverse proxy, set this to the address the app sees the proxy
# connect from (or a comma-separated list; ranges such as 172.18.0.0/16 work
# for a proxy container whose address changes). Unset, no proxy is trusted.
# - Docker, proxy on the host: the Docker network's gateway, often 172.18.0.1
#   (docker network inspect shows it). That also trusts anything reaching the
#   published port through the host, so set WEB_BIND=127.0.0.1 with it.
# - Docker, proxy in a container on the same network: that container's address.
# - Host networking, or a run outside Docker, with the proxy on the same
#   machine connecting to localhost: 127.0.0.1 (add ::1 if WEB_HOST is ::).
# Don't set it to "*" unless the app is ONLY reachable through a proxy that
# overwrites X-Forwarded-For.
# FORWARDED_ALLOW_IPS=172.18.0.1

# With WEB_AUTH=none, and on the first-visit setup screen, the web UI answers
# only to IP addresses, localhost, single-label names (nas) and names ending in
# .local, .lan, .home, .home.arpa, .internal, .localdomain or .fritz.box. List
# any other name you open it by here, comma-separated, without scheme or port.
# Requests from a proxy named in FORWARDED_ALLOW_IPS are not checked.
# WEB_ALLOWED_HOSTS=music.example.com

# Start in terminal mode: `docker compose run --rm -it qobuz-librarian cli`
# works immediately and the web UI's downloads stay paused. Saving a Qobuz
# token on Settings needs web mode. Settings → Mode switches case by case.
# QL_CLI_ONLY=1

# ── User / permissions ────────────────────────────────────────────────────────
# With PUID=0 and PGID=0 the app runs as root; a non-numeric value makes the
# container refuse to start.
#
# Writable home inside a read-only container. The default /tmp matches the
# documented --tmpfs /tmp setup. If your Compose override mounts /var/tmp
# instead, set APP_HOME=/var/tmp here as well.
# APP_HOME=/var/tmp
#
# Timezone for exact timestamps in History and on job pages (relative times
# like "2 hr ago" are unaffected). Use an IANA name; unset = UTC.
# TZ=America/Edmonton
#
# Volume writability check (default 1). At boot the container chowns the
# app's own volumes; write endpoints return 503 while /music or /staging is
# not writable and recover as soon as it is. A /music share mounted read-only
# (`:ro`) is not paused: scans run and downloads are off.
# QL_CHECK_VOLUMES=1

# ── Qobuz auth (optional) ─────────────────────────────────────────────────────
# Easiest set from the Settings page in the web UI.
# The token is streamrip's `password_or_token` (NOT your password): get it
# from play.qobuz.com: dev tools (F12) → Application → Local Storage →
# play.qobuz.com → the `localuser` entry's `token`. USER_ID is
# your account email or numeric Qobuz user id. A token set here can't be
# changed on the Settings page.
# QOBUZ_USER_AUTH_TOKEN=your_token_here
# QOBUZ_USER_ID=your_user_id_here
# Or read the token from a file (e.g. a Docker secret):
# QOBUZ_USER_AUTH_TOKEN_FILE=/run/secrets/qobuz_token

# ── Discover (optional) ───────────────────────────────────────────────────────
# A Last.fm API key turns on the Discover tab. The key's Last.fm account
# needs Pro. Get one at https://www.last.fm/api/account/create, or paste it
# on the Settings page.
# LASTFM_API_KEY=your_lastfm_api_key
# Or read it from a file (e.g. a Docker secret) instead:
# LASTFM_API_KEY_FILE=/run/secrets/lastfm_api_key

# ── Behaviour overrides (optional) ────────────────────────────────────────────
# Some of these mirror a control on the Settings page. A setting changed there
# wins over the value here, in both the web app and CLI; setting it back, or
# clearing a text field, lets the value here apply again. Keys with no
# Settings control always apply from here. Defaults shown.
#
# Quality tier: 2=CD lossless · 3=24/96 · 4=24/192
# STREAMRIP_QUALITY=4
# PREFER_HIRES=1
# Per-album rip subprocess timeout (seconds), and the pause between consecutive
# album downloads. Raise RIP_TIMEOUT for very large hi-res albums on slow disks;
# raise DELAY_BETWEEN if Qobuz rate-limits a long unattended run.
# RIP_TIMEOUT=900
# DELAY_BETWEEN=1.0
# Free-space floor (MB) checked before each album download; a near-full staging
# area stops the queue and keeps the rest to retry. Set 0 to disable.
# MIN_FREE_STAGING_MB=500
# CONSOLIDATE=0
# Re-file "Primary, Other/Album" or "Other, Primary/Album" under "Primary/Album"
# after import, Primary being the album's main artist on Qobuz; a Search Track
# download stays in its album's folder. Set 0 to keep the combined folder.
# MIGRATE_MULTI_ARTIST=1
# Web Library scans and new-release checks don't offer the rest of an album you
# took tracks from with a Search Track download, and skip an artist whose only
# folders came from such downloads. Other one-track folders are scanned as
# usual; the CLI walks ignore this setting.
# SUPPRESS_SINGLE_TRACK_GAPS=0
# Show Upgrade and include quality upgrades in Library scans; 0 hides Upgrade
# and skips that pass.
# UPGRADE_SCAN_ENABLED=1
# These two change files. AUTO_UPGRADE_ENABLED lets an ordinary CLI download or
# gap-fill run also upgrade an album Qobuz can now serve better in the same
# edition, which backs up and replaces the whole album folder after
# confirmation. DOWNSAMPLE_HIRES_ENABLED downsamples new hi-res downloads to
# 44.1/48 kHz on import.
# AUTO_UPGRADE_ENABLED=0
# DOWNSAMPLE_HIRES_ENABLED=0
# What the on-demand Downsample does with each hi-res original: keep a restorable
# copy (Settings → Diagnostics, until the backup retention window ends) or delete
# it to save space. Leave unset to be asked on the first downsample. keep/delete.
# DOWNSAMPLE_KEEP_ORIGINALS=
# Let the Upgrade walk also re-rip tracks you downloaded as singles.
# UPGRADE_SINGLES_ENABLED=0
# Count a release whose title marks it live/tour/session/acoustic as a live
# release in Missing Albums even when Qobuz files it as an album.
# EXCLUDE_LIVE_ALBUMS=0
#
# New releases: offer a first Library scan on first launch and resume an
# interrupted one (off does neither), and
# how often (seconds) to check for new releases after it (0 = off).
# AUTO_LIBRARY_SCAN=1
# NEW_RELEASE_CHECK_INTERVAL=86400
# Only flag albums released within this many days as "new" (0 = any catalogue
# newcomer counts, including older releases Qobuz recently added). Default 365.
# NEW_RELEASE_MAX_AGE_DAYS=365
# How long (seconds) Library scans, Upgrade, Discover and artist pages reuse a
# fetched discography. The new-release check always fetches fresh.
# ARTIST_CATALOG_CACHE_TTL=604800
#
# Lyrics: embed | sidecar | both. Providers: Lrclib, NetEase, Megalobiz, Musixmatch, Genius.
# LYRICS_ENABLED=1
# LYRICS_FORMAT=embed
# Empty tries Lrclib and Musixmatch, in that order; set this to choose from
# Lrclib, NetEase, Megalobiz, Musixmatch and Genius.
# LYRICS_PROVIDERS=
# LYRICS_PROVIDER_TIMEOUT=30
#
# Container path for collection backups from completed Library scans and
# terminal Library walks and Gap Fill runs.
# The bundled Compose setup keeps this on the QL_COLLECTION_BACKUPS bind
# mount above. Only change this if you also add a matching mount.
# COLLECTION_BACKUP_DIR=/collection_backups
#
# Cover art of downloads: sidecar (cover file beside the tracks, none in
# them) | embed (in each track, no cover file) | both.
# ARTWORK=both
#
# Compose keeps the beets database on its supported local /config named volume.
# If you replace that volume with a bind mount, use a local Linux filesystem;
# NFS and SMB/CIFS are not supported for the database. See docs/configuration.md.
# To use an existing database under another name on that volume:
# BEETS_DB_PATH=/config/beets/library.db
#
# beets path templates (empty = honour beets/config.yaml). beets path syntax.
# BEETS_PATH_DEFAULT='$albumartist/$album ($year)/$track - $title'
# BEETS_PATH_COMP='Various Artists/$album ($year)/$track - $title'
# When set, this replaces config.yaml plugin choices for managed imports. The
# app adds inline, its internal import guards, and fetchart unless
# ARTWORK=embed.
# Extra plugins may need dependencies not bundled in the image.
# BEETS_PLUGINS=
#
# beets import guard: seconds of *no output* before a stalled import is
# killed and the album quarantined for retry (a slow-but-progressing import is
# never killed). Worth raising on a slow NAS; 0 disables the guard entirely
# (a stalled import can then hang until restart).
# BEETS_TIMEOUT=600
#
# Pause between Qobuz API calls during a library walk. Raise it only if the
# account gets rate-limited.
# ARTIST_API_DELAY=0.0
#
# How many artists a scan reads at once (1-16). Lower it on a slow or
# networked disk.
# ARTIST_SCAN_WORKERS=4
#
# A release with fewer tracks than this counts as an EP or single in Missing
# Albums. For an artist whose Qobuz release lists can't be read, shorter
# releases are left out.
# MISSING_ALBUMS_MIN_TRACKS=4
# UPGRADE_BACKUP_RETENTION_DAYS=7
# Repair scan: cache the Qobuz ISRC lookups so a re-scan skips the network (the
# files are still decode-tested fresh every scan). TTL_DAYS re-verifies a cached
# lookup that often; 0 keeps it until the db is deleted; ENABLED=false turns the
# cache off.
# REPAIR_CACHE_ENABLED=true
# REPAIR_CACHE_TTL_DAYS=30
#
# Run a command when a job finishes, when a scan leaves results to review, or
# when a restart cuts a job short, with the job's state as JSON on stdin.
# ntfy and Discord recipes are in docs/configuration.md#notifications.
# POST_JOB_HOOK=curl -s -o /dev/null -H "Title: Qobuz Librarian" -d @- https://ntfy.sh/your-topic
# POST_JOB_HOOK_TIMEOUT=10
#
# Parallel ffmpeg workers for Downsample (CPU-bound).
# RESAMPLE_WORKERS=4
#
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# LOG_LEVEL=INFO
