# Dev-only files that shouldn't bloat the image or invalidate cache layers.
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov/

# Host-installed Node deps and Tailwind build artifacts; the builder stage
# installs fresh inside the image.
node_modules
.tailwindcache
src/qobuz_librarian/web/static/dist

# CI configuration is not needed in the build context. Tests are available to
# the explicit test stage but are never copied into the runtime image.
.github/

# VCS + ignored locals.
.git
.gitignore
.gitattributes
.env
*.local

# Build artifacts.
*.egg-info
dist/
build/

# README assets.
assets/

# Docs only the README links to.
CHANGELOG.md
CONTRIBUTING.md
