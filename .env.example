# Copy this file to .env and edit the paths for your system.
#   cp .env.example .env
# .env is gitignored, so your personal paths stay out of the repo.

# ── Host directories mounted into the container ───────────────────────────────
# Compose keeps the beets database on its supported local /config named volume.
# If you replace that volume with a bind mount, use a local Linux filesystem;
# NFS and SMB/CIFS are not supported for the database. See docs/configuration.md.
# Your music library (beets moves imported files here, read-write).
# Starting fresh? Create the folder yourself before the first start; Docker
# creates a missing bind source as root, which the app can't write to.
# Music, staging, and upgrade-backup directories must be separate. Do not put
# any one of them inside another.
QL_MUSIC_DIR=./music

# Scratch space for in-progress streamrip downloads.
QL_STAGING_DIR=./staging

# Where pre-upgrade backups are kept before a quality upgrade replaces files.
QL_UPGRADE_BACKUPS=./upgrade_backups

# Library migration (optional; only for the one-time Migrate tool). These are
# container paths; mount the matching host folders in Compose before using them.
# See docs/existing-libraries.md for the full example.
# MIGRATE_SRC=/migrate-source
# MIGRATE_DEST=/migrate-dest

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host port the web UI is published on.
WEB_PORT=8666
# Host interface the port is published on. Default 0.0.0.0 = reachable from your
# LAN. Set 127.0.0.1 to keep the UI reachable only from the Docker host.
# (This is the Docker-correct local-only control, not WEB_HOST, which is the
# in-container bind and must stay 0.0.0.0 for the published port to work.)
# WEB_BIND=0.0.0.0

# Login. Leave this unset (or anything other than "none") and the web UI asks
# you to pick a username and password on first visit, then requires sign-in.
# Set WEB_AUTH=none to turn the login off entirely: no setup screen, no
# prompt. Use this only on a trusted network or behind your own authenticating
# reverse proxy; anyone who can reach an unauthenticated UI has full control of
# the app.
# WEB_AUTH=none

# Optionally set the login here instead of on the first-visit setup screen.
# Provide both: the container comes up already locked down (no open setup
# window) and these double as a password reset: change them and restart to
# update the login. They're only read when both are set; once a login exists,
# the same pair is left alone unless the password here changes. Pick a strong
# password of at least 15 characters. Common and product-name passwords are
# refused. An env value is visible to anyone who can inspect the container (you
# can clear these after first start; the login persists).
# WEB_AUTH_USER=admin
# WEB_AUTH_PASSWORD=change-me-to-something-strong
# Or keep the password out of the environment and read it from a file (e.g. a
# Docker secret), matching QOBUZ_USER_AUTH_TOKEN_FILE below. Set this
# instead of WEB_AUTH_PASSWORD:
# WEB_AUTH_PASSWORD_FILE=/run/secrets/qobuz_web_password

# Behind a reverse proxy? Set this to the proxy's IP (or a comma-separated
# list) so the app trusts its X-Forwarded-For and the failed-login throttle
# keys on the real client instead of locking everyone out behind one shared
# proxy address. Leave unset (defaults to 127.0.0.1) when the container is
# reached directly. Don't set it to "*" unless the container is ONLY reachable
# through a proxy that overwrites X-Forwarded-For; otherwise that header is
# spoofable and the throttle is defeated.
# FORWARDED_ALLOW_IPS=172.18.0.1

# Terminal-first mode (optional). The web app and CLI share one download lock,
# so they take turns. Set this to 1 to start in terminal mode:
# `docker exec ... qobuz-librarian` works immediately and the web UI's downloads
# stay paused (you can still browse + use Settings, and resume web mode there).
# Leave unset to default to the web app. To hand off case-by-case instead, use
# Settings → Mode in the web UI.
# QL_CLI_ONLY=1

# ── User / permissions ────────────────────────────────────────────────────────
# The app runs as this uid/gid (default 1000:1000) so downloaded files match
# you, not root. Find your values with `id -u` and `id -g` on the host and set
# them here if they aren't 1000; they flow straight into the container, no
# need to edit compose.yaml. Set PUID=0 and PGID=0 to run as root if you really
# need it; a non-numeric value (a typo) makes the container refuse to start
# rather than silently fall back to root.
# PUID=1000
# PGID=1000
# Writable home inside a read-only container. The default /tmp matches the
# documented --tmpfs /tmp setup. If your Compose override mounts /var/tmp
# instead, set APP_HOME=/var/tmp here as well.
# APP_HOME=/var/tmp
#
# Timezone for exact timestamps in History and on job pages (relative times
# like "2 hr ago" are unaffected). Use an IANA name; unset = UTC.
# TZ=America/Edmonton
#
# Volume writability check (default 1). At boot the container chowns the
# app's own volumes; write endpoints return 503 while /music or /staging is
# not writable and recover as soon as it is. If your /music share is mounted
# read-only (`:ro`), set this to 0 so scans and upgrade detection still run.
# QL_CHECK_VOLUMES=1

# ── Qobuz auth (optional) ─────────────────────────────────────────────────────
# Easiest to set these from the Settings page in the web UI instead; leave
# them commented here and the dashboard will prompt you on first run.
# The token is streamrip's `password_or_token` (NOT your password): get it
# from play.qobuz.com: dev tools (F12) → Application → Local Storage →
# play.qobuz.com → the `localuser` entry's `token`. USER_ID is
# your account email or numeric Qobuz user id. Setting them here pins them
# (the Settings page can't override an env-provided token until it's unset).
# QOBUZ_USER_AUTH_TOKEN=your_token_here
# QOBUZ_USER_ID=your_user_id_here
# Or keep the token out of the environment entirely and read it from a file
# (e.g. a Docker secret); set this instead of QOBUZ_USER_AUTH_TOKEN:
# QOBUZ_USER_AUTH_TOKEN_FILE=/run/secrets/qobuz_token

# ── Behaviour overrides (optional) ────────────────────────────────────────────
# Most of these mirror a control on the web UI's Settings page, and the value
# here is the DEFAULT. The web app persists Settings-page changes under /data and
# applies them over these env values at startup, so once you save a setting in
# the UI it wins in both the web app and CLI (clear it there, or delete
# /data/.qobuz_settings.json, to let the env value apply again). For keys with
# no Settings control (e.g. BEETS_TIMEOUT, RESAMPLE_WORKERS, LOG_LEVEL,
# POST_JOB_HOOK*), the env value always applies. Defaults shown; uncomment what
# you want to set.
#
# Quality tier: 2=CD lossless · 3=24/96 · 4=24/192
# STREAMRIP_QUALITY=4
# PREFER_HIRES=1
# Per-album rip subprocess timeout (seconds), and the pause between consecutive
# album downloads. Raise RIP_TIMEOUT for very large hi-res albums on slow disks;
# raise DELAY_BETWEEN if Qobuz rate-limits a long unattended run.
# RIP_TIMEOUT=900
# DELAY_BETWEEN=1.0
# Free-space floor (MB) checked before each album download; a near-full staging
# area stops the queue cleanly (and keeps the rest to retry) instead of failing
# album after album. Set 0 to disable.
# MIN_FREE_STAGING_MB=500
# CONSOLIDATE=0
# Re-file "Primary, Other/Album" under "Primary/Album" after import.
# MIGRATE_MULTI_ARTIST=0
# Turn off the Upgrade surface and skip upgrade scanning entirely.
# UPGRADE_SCAN_ENABLED=1
# These two change files. AUTO_UPGRADE_ENABLED lets an ordinary CLI download or
# gap-fill run also upgrade an album Qobuz can now serve better, which backs up
# and replaces the whole album folder after confirmation. Ordinary web
# downloads keep the selected edition; the Upgrade page reviews replacements.
# DOWNSAMPLE_HIRES_ENABLED downsamples NEW hi-res downloads to 44.1/48 kHz on
# import; to downsample hi-res already in your library, use the on-demand
# Downsample page/mode instead (no setting needed).
# AUTO_UPGRADE_ENABLED=0
# DOWNSAMPLE_HIRES_ENABLED=0
# What the on-demand Downsample does with each hi-res original: keep a restorable
# copy (Settings → Diagnostics, until the backup retention window ends) or delete
# it to save space. Leave unset to be asked on the first downsample. keep/delete.
# DOWNSAMPLE_KEEP_ORIGINALS=keep
# Let the Upgrade walk also re-rip tracks you downloaded as singles (off by
# default; a single is a deliberate one-off, so the walk leaves it alone).
# UPGRADE_SINGLES_ENABLED=0
# Drop obvious live/tour/session/acoustic releases from the "missing albums" gap
# list (off by default; the guard never drops a studio album whose real title
# contains "Live" as part of another word).
# EXCLUDE_LIVE_ALBUMS=0
#
# New releases: offer a one-time baseline scan on first launch (off skips it),
# and how often (seconds) to auto-check for new releases afterwards (0 = off).
# AUTO_LIBRARY_SCAN=1
# NEW_RELEASE_CHECK_INTERVAL=86400
# Only flag albums released within this many days as "new" (0 = any catalogue
# newcomer counts, including older releases Qobuz recently added). Default 365.
# NEW_RELEASE_MAX_AGE_DAYS=365
#
# Lyrics: embed | sidecar | both. Providers: Lrclib, NetEase, Megalobiz, Musixmatch, Genius.
# LYRICS_ENABLED=1
# LYRICS_FORMAT=embed
# LYRICS_PROVIDERS=Lrclib,NetEase,Musixmatch
# LYRICS_PROVIDER_TIMEOUT=30
#
# Where the collection backup is written after each library scan: a JSON list
# of every artist, album and track in your library.
# Empty = kept with the app's other data.
# COLLECTION_BACKUP_DIR=/data/collection-backups
#
# Cover art placement: sidecar (image beside the tracks) | embed | both.
# ARTWORK=sidecar
#
# beets path templates (empty = honour beets/config.yaml). beets path syntax.
# BEETS_PATH_DEFAULT='$albumartist/$album ($year)/$track - $title'
# BEETS_PATH_SINGLETON='$albumartist/$album ($year)/$track - $title'
# BEETS_PATH_COMP='Various Artists/$album ($year)/$track - $title'
# This replaces config.yaml plugin choices for managed imports. The app adds
# inline, artwork requirements, and its internal import guards.
# BEETS_PLUGINS=fetchart,lastgenre,replaygain
#
# beets import guard: seconds of *no output* before a stalled import is
# killed and the album quarantined for retry (a slow-but-progressing import is
# never killed), how many attempts, and the pause between them. Worth raising
# on a slow NAS; 0 disables the guard entirely (a stalled import can then hang
# until restart).
# BEETS_TIMEOUT=600
# BEETS_MAX_ATTEMPTS=2
# BEETS_RETRY_PAUSE=30
#
# API pacing and retry knobs. Leave these at their defaults unless Qobuz
# rate-limits the account or your network needs slower retries.
# RATE_LIMIT_COOLDOWN=30
# ARTIST_API_DELAY=0.0
# UPGRADE_BACKUP_RETENTION_DAYS=7
# Minimum gap (seconds) between a repair sweep's live Qobuz ISRC lookups, across
# all workers; paces a cold scan so it doesn't burst the account. 0 disables it.
# REPAIR_LOOKUP_MIN_INTERVAL=0.05
#
# Repair scan: cache the Qobuz ISRC lookups so a re-scan skips the network (the
# files are still decode-tested fresh every scan). TTL_DAYS re-verifies a cached
# lookup that often; 0 keeps it until the db is deleted; ENABLED=false turns the
# cache off.
# REPAIR_CACHE_ENABLED=true
# REPAIR_CACHE_TTL_DAYS=30
#
# Run a command when a job finishes (download / scan / upgrade / …) with the
# job's final state as JSON on stdin; wire up a phone/desktop notification or
# your own automation. curl ships in the image, so an ntfy push is one line;
# ready-made ntfy and Discord recipes are in docs/configuration.md#notifications.
# Unset = nothing runs; the timeout caps a slow webhook.
# POST_JOB_HOOK=curl -s -o /dev/null -H "Title: Qobuz Librarian" -d @- https://ntfy.sh/your-topic
# POST_JOB_HOOK_TIMEOUT=10
#
# Parallel ffmpeg workers for the on-demand downsample (CPU-bound).
# RESAMPLE_WORKERS=4
#
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# LOG_LEVEL=INFO
#
# Web UI per-request budgets (seconds). Bump if your Qobuz API calls
# routinely time out; drop if you'd rather fail fast on a slow network.
# QL_WEB_FETCH_TIMEOUT bounds album/track fetches and the search box.
# QL_WEB_TEST_AUTH_TIMEOUT bounds the startup + Settings token probe.
# QL_WEB_FETCH_TIMEOUT=12.0
# QL_WEB_TEST_AUTH_TIMEOUT=8.0
#
# Web job logs. JOB_LOG_CAP bounds the live lines retained per job;
# JOB_LOG_REPLAY_TAIL is how many prior lines a newly opened progress page
# receives (0 = live output only).
# JOB_LOG_CAP=5000
# JOB_LOG_REPLAY_TAIL=500
#
# Web live-update streams. Raise the worker count for many simultaneous tabs.
# Lower the heartbeat ticks if a reverse proxy drops quiet connections early;
# each tick is 0.5 seconds, so the default sends a keepalive after 15 seconds.
# SSE_MAX_WORKERS=16
# SSE_HEARTBEAT_TICKS=30
